package Idris2-SystemsBiology-Wiki
version = 0.1.0
authors = "Justin Kelly"
brief   = "Discrete Systems Biology, Metabolic Networks & Physiological Systems Architecture Specification Wiki"

depends = base
        , contrib
        , Idris2-Multiset-Core
        , Idris2-Multiset-Transform
        , Idris2-Geometry
        , Idris2-Physics
        , Idris2-Chemistry
        , Idris2-Biology
        , idris2-Dihedron
        , idris2-QuickCheck

sourcedir = "Library"

modules = Wiki.Observations.MetabolicPathway
        , Wiki.Observations.GeneRegulatoryNetwork
        , Wiki.Observations.NeuralActionPotential
        , Wiki.Observations.SignalTransductionCascade
        , Wiki.PhotosyntheticCoherence
        , Wiki.StoichiometricMultiset
        , Wiki.LinearATPEnzyme
        , Wiki.ScaleTransforms
        , Wiki.Reflect.SystemsBiologyAuditor
        , Wiki.Reflect.SystemsBiologyMacroSolver

main = Wiki.Main
executable = systems-biology-wiki
